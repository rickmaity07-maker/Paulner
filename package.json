{
  "name": "paulaner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:setup": "node --env-file-if-exists=.env.local scripts/setup-db.mjs",
    "mail:preview": "npx -y tsx --conditions=react-server --env-file-if-exists=.env.local scripts/mail-preview.mts",
    "app:release": "node --env-file-if-exists=.env.local scripts/release-app.mjs",
    "test:api": "node scripts/test-app-api.mjs",
    "test:web": "node scripts/test-website.cjs",
    "test:touch": "node scripts/test-touch.cjs",
    "test:prod": "node scripts/smoke-production.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "audit": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@phosphor-icons/react": "^2.1.10",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "motion": "^14.0.0",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/blob": "^2.9.0",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "zod": "^4.6.7",
    "undici": "^6.29.1"
  }
}
