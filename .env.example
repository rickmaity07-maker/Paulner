# Copy to .env.local (and add the same variables in Vercel).
#
# Neon Postgres connection string: Neon console -> project "paulaner" -> Connect.
# Without it the public site still renders from its built-in menu and hours,
# but bookings, /login and the admin portal are unavailable.
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Then create the tables and the first owner account:
#   npm run db:setup -- owner@example.com "a-long-password"
# Everyone signs in at /login. Owners are sent to /admin, guests to /profile.
# Owners can promote other accounts under "Nutzer & Rollen".

# --- Email for bookings (same setup as Bar-05) ---
# A Gmail account with 2-Step Verification and an App Password from
# myaccount.google.com/apppasswords (not the normal Gmail password).
GMAIL_USER=your.account@gmail.com
GMAIL_APP_PASSWORD=your-16-letter-app-password
GMAIL_FROM_NAME=Paulaner Meets Route 66
# Where new booking requests are sent. Several addresses: separate with commas.
RESERVATION_NOTIFY_EMAIL=inhaber@example.com
# Optional: another mail server instead of Gmail, with the same user and password.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587

# --- Google sign-in (optional, free) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URIs:
#   https://<your-domain>/api/auth/google/callback
#   http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret

# --- Daily data clean-up (DSGVO retention), called by Vercel Cron ---
CRON_SECRET=a-long-random-string
